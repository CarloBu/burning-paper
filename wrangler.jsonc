{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burning-paper",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "PAPERS", "class_name": "Paper" },
      { "name": "WHISPERS", "class_name": "WhisperRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Paper"] },
    { "tag": "v2", "new_sqlite_classes": ["WhisperRoom"] }
  ],
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 30, "period": 60 }
  }],
  "observability": { "enabled": false }
}
