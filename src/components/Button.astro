---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary';
}

const { variant = 'primary', type = 'button', class: className, ...attributes } = Astro.props;
---

<button {...attributes} type={type} class:list={['button', `button--${variant}`, className]}>
  <span><slot /></span>
</button>

<style>
  .button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: #e1e6ee;
    font: inherit;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms, border-color 160ms, background 160ms, box-shadow 160ms, transform 160ms;
  }

  .button--primary {
    width: 100%;
    min-height: 49px;
    padding: 12px 16px;
    border: 1px solid #a8b2c2;
    background: linear-gradient(#e1e8f00b, #d5deea03);
    box-shadow: inset 0 1px #ffffff05, 0 2px 4px #0003;
    font-size: 13px;
    font-weight: 500;
  }

  .button--secondary {
    width: fit-content;
    min-height: 36px;
    padding: 8px;
    color: var(--muted);
    font-size: 12px;
  }

  .button:disabled {
    cursor: default;
    border-color: #737373;
    color: var(--muted);
  }

  .button:focus-visible {
    outline: 1px solid #d4d4d4;
    outline-offset: 5px;
  }

  @media (hover: hover) {
    .button:hover:not(:disabled) { color: #fff; }
    .button--primary:hover:not(:disabled) { border-color: #d4d4d4; background-color: #d4d4d40a; }
  }
  .button:active:not(:disabled) { transform: translateY(1px); box-shadow: inset 0 1px 3px #0008; }
  @media (prefers-reduced-motion: reduce) { .button { transition: none; } }
</style>
