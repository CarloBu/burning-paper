<section class="message-stage air-stage" id="whisper-stage" data-view="compose" aria-label="Your whisper" hidden>
  <canvas class="air-canvas" id="whisper-air" aria-hidden="true"></canvas>
  <div class="air-content" id="whisper-content"></div>
  <p id="whisper-wait" class="whisper-wait" hidden><span id="whisper-progress" role="status">Waiting for your recipient. Keep this tab open and connected.</span><br />Link expires in <span id="whisper-countdown" class="timer">10:00</span></p>
</section>
