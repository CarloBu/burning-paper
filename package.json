{
  "name": "burning-paper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "astro build && wrangler dev",
    "dev:ui": "astro dev",
    "dev:worker": "wrangler dev --port 8787",
    "build": "astro build",
    "deploy": "astro build && wrangler deploy",
    "test": "vitest run",
    "check": "node --check src/worker.js"
  },
  "dependencies": {
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.12",
    "vitest": "4.1.11",
    "wrangler": "4.134.0"
  }
}
